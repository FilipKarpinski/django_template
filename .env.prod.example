DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY="CHANGE-ME-to-a-real-secret-key"
DJANGO_ALLOWED_HOSTS="yourdomain.com,www.yourdomain.com"
CSRF_TRUSTED_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
SECURE_SSL_REDIRECT=1

POSTGRES_USER=djangouser
POSTGRES_PASSWORD=CHANGE-ME-to-a-real-password
POSTGRES_DB=djangodb
DATABASE_URL="postgres://djangouser:CHANGE-ME-to-a-real-password@db:5432/djangodb"

APP_IMAGE=ghcr.io/your-org/your-app:latest
